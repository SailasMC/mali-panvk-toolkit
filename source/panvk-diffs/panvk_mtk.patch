+    * the fd (closing it here would trigger an fdsan double-close).  Treat
+    * the imported sync as already complete; panvk waits on the GPU on the
+    * CPU before presenting anyway. */
+   kbase_cpu_sync_signal(device, sync, 0);
+   return VK_SUCCESS;
+}
