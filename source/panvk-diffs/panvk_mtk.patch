+static VkResult
+kbase_cpu_sync_export_file(struct vk_device *device, struct vk_sync *sync,
+                           int *sync_file)
+{
+   /* The Android swapchain presents with this SYNC_FD.  kbase submissions
+    * are asynchronous, so the present fence must not claim completion until
+    * the GPU has actually finished writing the frame -- otherwise the display
+    * scans out a partially-rendered buffer.  Resolve the pending GPU seqnos
+    * on the CPU here, then hand back a signaled fence. */
+   struct kbase_cpu_sync *ks = container_of(sync, struct kbase_cpu_sync, sync);
+
+   *sync_file = -1;
+   return VK_SUCCESS;
+}
+
+static VkResult
+kbase_cpu_sync_import_file(struct vk_device *device, struct vk_sync *sync,
+                           int sync_file)
+{
