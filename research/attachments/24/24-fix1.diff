--- src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c.bak-1791176223	2026-10-05 12:57:03.131764420 +0800
+++ src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c	2026-10-05 12:57:08.287852113 +0800
@@ -60,7 +60,12 @@
  * kernel ring slot size. */
 #define KBASE_RING_JOB_MAX_SIZE 512
 /* Generous timeout for the synchronous submission model. */
-#define KBASE_WAIT_TIMEOUT_NS  (10ll * 1000000000ll)
+/* Mitigation only -- this does NOT make the completion signal arrive.  The
+ * working G610/uAPI-1.18 MTK precedent raised it to 120 s (BkaNeko/
+ * panvk-mtk-driver, patches/panvk_mtk.patch:180-181).  Do NOT ship this
+ * alone: it turns a 10 s crash into a 120 s crash and stretches every
+ * diagnostic window by 12x.  Apply only after fix1/fix2 have been A/B'd. */
+#define KBASE_WAIT_TIMEOUT_NS  (120ll * 1000000000ll)
 #define KBASE_SEQNO_LS_COPY_OFFSET       16
 #define KBASE_SEQNO_MARK_PRE_CALL_OFFSET 24
 #define KBASE_SEQNO_MARK_POST_CALL_OFFSET 32
@@ -708,21 +713,23 @@
    *(volatile uint64_t *)(input_page + CS_USER_IO_INPUT_CS_INSERT) =
       subq->kbase.insert;
 
-   /* Active queues can consume a userspace doorbell without an ioctl.  Check
-    * CS_ACTIVE again after ringing it; if a suspend raced the write, the
-    * scheduler kick below safely resumes the group. */
-   kbase_gpu_wmb();
-   uint8_t *output_page = (uint8_t *)subq->kbase.user_io + 8192;
-   volatile uint32_t *active =
-      (volatile uint32_t *)(output_page + CS_USER_IO_OUTPUT_CS_ACTIVE);
-
-   if (*active) {
-      *(volatile uint32_t *)subq->kbase.user_io = 1;
-      kbase_gpu_wmb();
-      if (*active)
-         return;
-   }
-
+   /* Always kick the scheduler.  The userspace doorbell fast path can race
+    * an active->idle transition and drop the newly inserted job, leaving the
+    * GPU idle with pending work until the wait watchdog gives up.
+    *
+    * Precedent (same code base, same vendor path, working on MTK kbase):
+    * BkaNeko/panvk-mtk-driver, patches/panvk_mtk.patch:197-201 deletes this
+    * exact block with exactly this rationale.
+    *
+    * Aggravating factor on this tree: the fast path read CS_ACTIVE twice with
+    * no cache invalidate in between.  kbase_gpu_wmb() is only "dsb sy" (see
+    * gpu_queue.c:148-157), unlike kbase_cache_invalidate_range() which issues
+    * dc civac per line.  A stale non-zero second read therefore skips the
+    * kick even after the kernel has already suspended the queue.
+    * Note a hardware doorbell write (user_io page 0, see
+    * include/drm-uapi/mali_kbase_ioctl.h:392-396) can only wake a CS that is
+    * already scheduled; it cannot resume an off-slot CSG.  That is what
+    * KBASE_IOCTL_CS_QUEUE_KICK is for. */
    kbase_kmod_csf_queue_kick(dev->kmod.dev, subq->kbase.ringbuf_dev);
 }
 
