# GitHub Actions 工作流模板
#
# 启用方法（二选一）：
#   A. 网页上手动加：仓库 → Add file → Create new file →
#      文件名填 `.github/workflows/build-panvk.yml`，把本文件内容粘进去 → Commit
#   B. 本地：mkdir -p .github/workflows && cp ci/build-panvk.yml.example .github/workflows/build-panvk.yml
#
# 之后在 Actions 页面点 “Build PanVK (kbase / Android) → Run workflow” 即可，
# 编完在 Artifacts 里下载 libvulkan_panfrost.so。
#
# 说明：GitHub 要求推送 `.github/workflows/**` 的 token 具备 `workflow` 权限，
#       所以本仓库把它作为模板放在 `ci/` 下而不是直接放在 `.github/` 里。
name: Build PanVK (kbase / Android)

on:
  workflow_dispatch:
    inputs:
      profile:
        description: 'GPU profile（g720-v12-csf / g615-v11-csf / g610-v10-csf / g57-v9-jm / g52-v7-jm）'
        required: true
        default: 'g720-v12-csf'
      api:
        description: 'Android API level'
        required: true
        default: '35'

jobs:
  build:
    runs-on: ubuntu-24.04
    timeout-minutes: 180

    steps:
      - name: Checkout 本仓库
        uses: actions/checkout@v4

      - name: 安装构建依赖（含本仓库踩过的坑）
        run: sudo bash build/deps-debian.sh

      - name: 安装 Android NDK
        id: ndk
        uses: nttld/setup-ndk@v1
        with:
          ndk-version: r27c

      - name: 克隆并构建 PanVK（zenithblue 基线 + G720 修正）
        env:
          ANDROID_NDK_ROOT: ${{ steps.ndk.outputs.ndk-path }}
          PROFILE: ${{ inputs.profile }}
          API: ${{ inputs.api }}
        run: bash build/build_g720.sh "$PWD/panvk-out"

      - name: 输出驱动形态与能力
        run: |
          NDK="${{ steps.ndk.outputs.ndk-path }}"
          CC=$(ls -d "$NDK"/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android26-clang)
          "$CC" -O2 -o vkicd_probe tools/vkicd_probe.c -ldl
          echo "===== vkicd_probe: ${{ inputs.profile }} ====="
          ./vkicd_probe panvk-out/*.so || true
          echo "===== sha256 ====="
          sha256sum panvk-out/*.so

      - name: 上传产物
        uses: actions/upload-artifact@v4
        with:
          name: libvulkan_panfrost-${{ inputs.profile }}
          path: |
            panvk-out/*.so
            vkicd_probe
          if-no-files-found: error
